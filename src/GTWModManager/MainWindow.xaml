<Window x:Class="GTWModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTW Mod Manager" Width="1060" Height="700" MinWidth="800" MinHeight="520"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        Background="#F6F7F9" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="72" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5F6670" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE1E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="LoaderRadio" TargetType="RadioButton">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="14">
        <!-- Game folder and mod loader -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Game folder" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GameDir}" Style="{StaticResource Hint}" Margin="0,2,0,10" />

                    <TextBlock Text="Mod loader" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <WrapPanel>
                        <RadioButton GroupName="Loader" Style="{StaticResource LoaderRadio}" Content="No mods"
                                     IsChecked="{Binding IsVanillaActive, Mode=OneWay}" IsEnabled="{Binding HasGame}"
                                     Command="{Binding SwitchLoaderCommand}" CommandParameter="None" />
                        <Separator Width="14" Visibility="Hidden" />
                        <RadioButton GroupName="Loader" Style="{StaticResource LoaderRadio}" Content="{Binding BepInExText}"
                                     IsChecked="{Binding IsBepInExActive, Mode=OneWay}" IsEnabled="{Binding BepInExInstalled}"
                                     Command="{Binding SwitchLoaderCommand}" CommandParameter="BepInEx" />
                        <Button Content="{Binding BepInExButtonText}" Padding="8,1" MinWidth="0" Command="{Binding InstallLoaderCommand}" CommandParameter="BepInEx"
                                ToolTip="Download the latest BepInEx 5 (x64) from GitHub" />
                        <Separator Width="18" Visibility="Hidden" />
                        <RadioButton GroupName="Loader" Style="{StaticResource LoaderRadio}" Content="{Binding MelonText}"
                                     IsChecked="{Binding IsMelonActive, Mode=OneWay}" IsEnabled="{Binding MelonInstalled}"
                                     Command="{Binding SwitchLoaderCommand}" CommandParameter="MelonLoader" />
                        <Button Content="{Binding MelonButtonText}" Padding="8,1" MinWidth="0" Command="{Binding InstallLoaderCommand}" CommandParameter="MelonLoader"
                                ToolTip="Download the latest MelonLoader (x64) from GitHub" />
                    </WrapPanel>
                    <TextBlock Text="{Binding LoaderHint}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Content="Browse..." Command="{Binding BrowseGameCommand}" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    <Button Content="Play" Command="{Binding LaunchCommand}" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Height="8" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                         IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Waiting for a browser download -->
        <Border DockPanel.Dock="Bottom" Background="#FFF7E6" BorderBrush="#F0C36D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0"
                Visibility="{Binding IsWaitingForDownload, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Choose file instead..." Command="{Binding PickDownloadedFileCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelWaitCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding WaitingText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <TabControl>
            <!-- Installed mods -->
            <TabItem Header="Installed">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Install from file..." Command="{Binding InstallFileCommand}" />
                            <Button Content="Open mods folder" Command="{Binding OpenModsFolderCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Tick a mod to load it. Mods for the loader that's off are greyed out. Drop .zip, .7z, .rar or .dll files here to install." />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StraysHint}" Foreground="#9A5B00" TextWrapping="Wrap" Margin="0,0,0,6" />

                    <DataGrid ItemsSource="{Binding Mods}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEEF1"
                              Background="White" BorderBrush="#DDE1E6" RowHeight="34" SelectionMode="Single">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoaderActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Load" Width="50">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanToggle}"
                                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="70" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Loader" Binding="{Binding LoaderText}" Width="1.1*" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Plugin ID" Binding="{Binding Guids}" Width="1.6*" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding KindText}" Width="1*" ElementStyle="{StaticResource Cell}" />
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.6*" ElementStyle="{StaticResource Cell}" />
                            <DataGridTemplateColumn Header="" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,4,0">
                                            <Button Content="Move into plugins" Padding="8,2"
                                                    Visibility="{Binding IsStray, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.AdoptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Padding="8,2"
                                                    Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Community mods -->
            <TabItem Header="Browse community mods">
                <DockPanel Margin="8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Mods from GitHub install directly. Nexus Mods files download in your browser, then install automatically." />
                    </DockPanel>

                    <ListBox ItemsSource="{Binding Catalog}" HorizontalContentAlignment="Stretch" Background="White" BorderBrush="#DDE1E6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="6,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock>
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="14" />
                                            <Run Text="  by " Foreground="#5F6670" />
                                            <Run Text="{Binding Author, Mode=OneWay}" Foreground="#5F6670" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,3" />
                                        <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                            <Run Text="{Binding StatusText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding LoaderText, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding SourceText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Website"
                                                Command="{Binding DataContext.OpenHomepageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="{Binding ActionText}" FontWeight="SemiBold"
                                                Command="{Binding DataContext.InstallCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Settings -->
            <TabItem Header="Settings">
                <StackPanel Margin="12" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Community mod list" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6"
                               Text="Raw URL of a mods.json file. Clear it and click Load to go back to the default list (github.com/Dullfin/gtw-mod-index)." />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Load" Command="{Binding SaveIndexUrlCommand}" />
                        <TextBox Text="{Binding IndexUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Padding="4,3" />
                    </DockPanel>

                    <TextBlock Text="Nexus Mods" FontWeight="SemiBold" Margin="0,22,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,6" TextWrapping="Wrap">
                        Optional. With a personal API key the app can check Nexus versions, and Premium accounts download straight into the game.
                        Without one, Nexus mods download in your browser and install from your Downloads folder.
                    </TextBlock>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove" Command="{Binding RemoveNexusKeyCommand}" />
                        <Button DockPanel.Dock="Right" Content="Save key" Click="SaveNexusKey_Click" />
                        <Button DockPanel.Dock="Right" Content="Get a key..." Command="{Binding OpenNexusKeysPageCommand}" />
                        <PasswordBox x:Name="NexusKeyBox" VerticalContentAlignment="Center" Padding="4,3" />
                    </DockPanel>
                    <TextBlock Text="{Binding NexusStatus}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                        <Run Text="Downloads folder watched for Nexus files: " />
                        <Run Text="{Binding DownloadsFolder, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
