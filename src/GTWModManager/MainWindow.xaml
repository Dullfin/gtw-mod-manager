<Window x:Class="GTWModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GTW Mod Manager" Icon="pack://application:,,,/Assets/app.ico" Width="1120" Height="780" MinWidth="860" MinHeight="560"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" PreviewKeyDown="Window_PreviewKeyDown"
        FontSize="13">
    <Grid Margin="20,12,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GTW Mod Manager" Style="{StaticResource TitleText}" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding GameDir}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ToolButton}" Command="{Binding BrowseGameCommand}" ToolTip="Choose the Get To Work folder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Game folder" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding RefreshCommand}" ToolTip="Rescan mods and reload the community list">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding LaunchCommand}" ToolTip="Start Get To Work through Steam">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                        <TextBlock Text="Play" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===================== New version of the app ===================== -->
        <Border Grid.Row="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Padding="8,6" ToolTip="Hide until next time"
                        Command="{Binding DismissUpdateCommand}">
                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" />
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Skip this version" Style="{StaticResource ToolButton}" Command="{Binding SkipUpdateCommand}" />
                    <Button Content="What's new" Style="{StaticResource ToolButton}" Command="{Binding OpenUpdatePageCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding UpdateNowCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock Text="Update now" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE895;" Style="{StaticResource Icon}" FontSize="18"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateBannerText}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="The app downloads the new version, swaps itself out and restarts. Your mods and settings stay as they are."
                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===================== Mod loader ===================== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Mod loader" Style="{StaticResource SectionText}" />
                    <TextBlock Text="{Binding LoaderHint}" Style="{StaticResource Hint}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="2" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="Loader" Style="{StaticResource Segment}" MinWidth="120"
                                         IsChecked="{Binding IsVanillaActive, Mode=OneWay}" IsEnabled="{Binding HasGame}"
                                         Command="{Binding SwitchLoaderCommand}" CommandParameter="None"
                                         ToolTip="Start the game without any mods">
                                <StackPanel>
                                    <TextBlock Text="No mods" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Vanilla game" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Loader" Style="{StaticResource Segment}" MinWidth="120"
                                         IsChecked="{Binding IsBepInExActive, Mode=OneWay}" IsEnabled="{Binding BepInExInstalled}"
                                         Command="{Binding SwitchLoaderCommand}" CommandParameter="BepInEx">
                                <StackPanel>
                                    <TextBlock Text="BepInEx" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding BepInExVersionText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="Loader" Style="{StaticResource Segment}" MinWidth="120"
                                         IsChecked="{Binding IsMelonActive, Mode=OneWay}" IsEnabled="{Binding MelonInstalled}"
                                         Command="{Binding SwitchLoaderCommand}" CommandParameter="MelonLoader">
                                <StackPanel>
                                    <TextBlock Text="MelonLoader" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding MelonVersionText}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Style="{StaticResource SmallButton}" Command="{Binding InstallLoaderCommand}" CommandParameter="BepInEx"
                                ToolTip="Download the latest BepInEx 5 (x64) from GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding BepInExButtonText}" />
                                <TextBlock Text=" BepInEx" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SmallButton}" Command="{Binding InstallLoaderCommand}" CommandParameter="MelonLoader"
                                ToolTip="Download the latest MelonLoader (x64) from GitHub">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding MelonButtonText}" />
                                <TextBlock Text=" MelonLoader" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Tabs ===================== -->
        <TabControl x:Name="MainTabs" Grid.Row="3" ItemContainerStyle="{StaticResource NavTab}">

            <!-- Installed -->
            <TabItem AutomationProperties.Name="Installed">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                        <TextBlock Text="Installed" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource ToolButton}" Command="{Binding OpenModsFolderCommand}" ToolTip="Open the active loader's mods folder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Open folder" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding InstallFileCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                    <TextBlock Text="Install from file" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Grid Width="280">
                            <TextBox x:Name="ModSearchBox" Text="{Binding ModSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchBox}" KeyDown="SearchBox_KeyDown" />
                            <TextBlock Style="{StaticResource SearchIcon}" />
                            <TextBlock Text="Search installed mods  (Ctrl+F)" Style="{StaticResource Placeholder}"
                                       Visibility="{Binding ModSearchIsEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding ModFilters}" SelectedItem="{Binding ModFilter}" Width="170" Margin="8,0,0,0"
                                  VerticalContentAlignment="Center" ToolTip="Show only some mods" />
                        <TextBlock Text="{Binding ModCountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,8"
                               Text="Tick a mod to load it. Mods for the loader that's off are dimmed. Drop .zip, .7z, .rar or .dll files anywhere to install." />

                    <!-- DLLs BepInEx can't see -->
                    <Border Grid.Row="2" CornerRadius="6" Padding="12,8" Margin="0,0,0,8"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StraysHint}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StraysHint}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding NoModsMatch, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                <TextBlock Text="No installed mods match." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <Button Content="Clear search and filter" Command="{Binding ClearModFiltersCommand}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding ModsView}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                                      Background="Transparent" RowBackground="Transparent" AlternatingRowBackground="Transparent"
                                      Foreground="{DynamicResource TextFillColorPrimaryBrush}" BorderThickness="0" RowHeight="42">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoaderActive}" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Resources>
                                    <Style x:Key="Cell" TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="Margin" Value="4,0" />
                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </Style>
                                    <Style x:Key="DimCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Load" Width="64">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          IsEnabled="{Binding CanToggle}"
                                                          Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Name" Width="2.2*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" Margin="4,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Guids}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80" ElementStyle="{StaticResource DimCell}" />
                                    <DataGridTextColumn Header="Loader" Binding="{Binding LoaderText}" Width="1.1*" ElementStyle="{StaticResource DimCell}" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding KindText}" Width="1*" ElementStyle="{StaticResource DimCell}" />
                                    <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="1.7*" ElementStyle="{StaticResource DimCell}" />
                                    <DataGridTemplateColumn Header="" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource SmallButton}" Content="Move into plugins"
                                                            Visibility="{Binding IsStray, Converter={StaticResource BoolToVis}}"
                                                            Command="{Binding DataContext.AdoptCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Style="{StaticResource SmallButton}" ToolTip="Remove (files go to the trash folder)"
                                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0" />
                                                            <TextBlock Text="Remove" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Community -->
            <TabItem AutomationProperties.Name="Browse community mods">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                        <TextBlock Text="Browse community mods" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding CheckUpdatesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <Grid Width="280">
                            <TextBox x:Name="CatalogSearchBox" Text="{Binding CatalogSearch, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchBox}" KeyDown="SearchBox_KeyDown" />
                            <TextBlock Style="{StaticResource SearchIcon}" />
                            <TextBlock Text="Search community mods  (Ctrl+F)" Style="{StaticResource Placeholder}"
                                       Visibility="{Binding CatalogSearchIsEmpty, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding CatalogFilters}" SelectedItem="{Binding CatalogFilter}" Width="160" Margin="8,0,0,0"
                                  VerticalContentAlignment="Center" ToolTip="Show only some mods" />
                        <ComboBox ItemsSource="{Binding CatalogTags}" SelectedItem="{Binding CatalogTag}" Width="140" Margin="8,0,0,0"
                                  VerticalContentAlignment="Center" ToolTip="Show mods with this tag" />
                        <TextBlock Text="{Binding CatalogCountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </DockPanel>

                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="2,10,0,8"
                               Text="GitHub mods install directly. Nexus Mods files download in your browser, then install automatically." />

                    <Grid Grid.Row="2">
                        <StackPanel Panel.ZIndex="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding NoCatalogMatch, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="No community mods match." Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <Button Content="Clear search and filters" Command="{Binding ClearCatalogFiltersCommand}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                        </StackPanel>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CatalogView}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Margin="0,0,4,8" Padding="16,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,16,0">
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="15" />
                                                        <Run Text="  by " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        <Run Text="{Binding Author, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,8"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                    <WrapPanel>
                                                        <!-- install state: green when installed, amber when an update is waiting -->
                                                        <Border CornerRadius="4" Padding="6,1" Margin="0,0,6,4" BorderThickness="1"
                                                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding LoaderText}" Style="{StaticResource BadgeText}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Badge}" Margin="0,0,6,4">
                                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource BadgeText}" />
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding TagList}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border CornerRadius="10" Padding="8,1" Margin="0,0,6,4"
                                                                            Background="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}">
                                                                        <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ToolButton}" ToolTip="Open the mod's page"
                                                            Command="{Binding DataContext.OpenHomepageCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                                            <TextBlock Text="Website" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Style="{StaticResource PrimaryButton}" MinWidth="104"
                                                            Command="{Binding DataContext.InstallCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding ActionText}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Settings -->
            <TabItem AutomationProperties.Name="Settings">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,4,0" MaxWidth="820" HorizontalAlignment="Left">

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                                    <TextBlock Text="Appearance" Style="{StaticResource SectionText}" />
                                </StackPanel>
                                <TextBlock Text="Choose light or dark mode, or follow your Windows setting." Style="{StaticResource Hint}" Margin="0,4,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton GroupName="Theme" Content="Use Windows setting" IsChecked="{Binding IsThemeSystem}" Margin="0,0,20,0" />
                                    <RadioButton GroupName="Theme" Content="Light" IsChecked="{Binding IsThemeLight}" Margin="0,0,20,0" />
                                    <RadioButton GroupName="Theme" Content="Dark" IsChecked="{Binding IsThemeDark}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                                    <TextBlock Text="Community mod list" Style="{StaticResource SectionText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8"
                                           Text="Raw URL of a mods.json file. Clear it and click Load to go back to the default list (github.com/Dullfin/gtw-mod-index)." />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Load" Style="{StaticResource ToolButton}" Command="{Binding SaveIndexUrlCommand}" />
                                    <TextBox Text="{Binding IndexUrl, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                                    <TextBlock Text="Nexus Mods" Style="{StaticResource SectionText}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,8">
                                    Optional. With a personal API key the app can check Nexus versions, and Premium accounts download straight into the game.
                                    Without one, Nexus mods download in your browser and install from your Downloads folder.
                                </TextBlock>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Remove" Style="{StaticResource ToolButton}" Command="{Binding RemoveNexusKeyCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Save key" Style="{StaticResource PrimaryButton}" Click="SaveNexusKey_Click" />
                                    <Button DockPanel.Dock="Right" Content="Get a key" Style="{StaticResource ToolButton}" Command="{Binding OpenNexusKeysPageCommand}" />
                                    <PasswordBox x:Name="NexusKeyBox" VerticalContentAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="{Binding NexusStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="Downloads folder watched for Nexus files: " />
                                    <Run Text="{Binding DownloadsFolder, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                                    <TextBlock Text="About" Style="{StaticResource SectionText}" />
                                </StackPanel>
                                <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AppUpdateStatus}" Style="{StaticResource Hint}" Margin="0,2,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ToolButton}" Margin="0" Command="{Binding CheckAppUpdateCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                            <TextBlock Text="Check for updates" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ToolButton}" Command="{Binding OpenReleasesPageCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                                            <TextBlock Text="All releases" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- ===================== Waiting for a browser download ===================== -->
        <Border Grid.Row="4" CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Visibility="{Binding IsWaitingForDownload, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Choose file instead" Style="{StaticResource ToolButton}" Command="{Binding PickDownloadedFileCommand}" />
                    <Button Content="Cancel" Style="{StaticResource ToolButton}" Command="{Binding CancelWaitCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE896;" Style="{StaticResource Icon}" FontSize="18"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,12,0" />
                <TextBlock Text="{Binding WaitingText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </DockPanel>
        </Border>

        <!-- ===================== Status bar ===================== -->
        <Grid Grid.Row="5" Margin="2,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="Active mod loader">
                <TextBlock Text="{Binding ActiveLoaderText}" Style="{StaticResource Caption}" />
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar Grid.Column="2" Width="180" Height="4" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                         IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </Grid>
</Window>
